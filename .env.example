# Renom panel environment example.
# Copy to .env and adjust. NEVER commit your .env.
# Production startup FAILS CLOSED unless JWT_SECRET is >= 32 chars (SEC-001).

NODE_ENV=development
HOST=127.0.0.1
PORT=8080

# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# One-time bootstrap token for the web setup screen (POST /setup/admin).
# The installer generates and prints it. Empty = no token required (dev only).
SETUP_TOKEN=

# Access-token lifetime in seconds (default 7 days)
JWT_TTL_SECONDS=604800

# Comma-separated allowlist; empty = same-origin only
CORS_ORIGINS=

# Behind a TLS terminator (reverse proxy)? "1" trusts X-Forwarded-For for
# client IPs (rate limits, audit). Leave "0" on direct exposure.
TRUST_PROXY=0

LOG_LEVEL=info

# Panel data root (database, server directories, backups)
DATA_DIR=./data

BCRYPT_COST=12
